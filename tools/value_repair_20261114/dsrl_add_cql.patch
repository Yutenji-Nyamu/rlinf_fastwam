+"""Two-candidate CQL penalty, following verl-vla SACTrainingWorker."""
+import torch
+def conservative_q_loss(q_data, q_candidate, temperature=1.0):
+    if temperature <= 0:
+        raise ValueError("temperature must be positive")
+    return (torch.logsumexp(torch.stack((q_data, q_candidate)) / temperature, dim=0) * temperature - q_data).mean()
