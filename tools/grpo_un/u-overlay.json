{
  "algorithm": {
    "dvac_gradient_weighting": {
      "mode": "apply",
      "application": "chunk_clipped_action_advantage",
      "normalization": "two_level_group",
      "signal_source": "ugrow_10_5",
      "scope": "both",
      "mapping": "exp_mean",
      "alpha_local": 1.0,
      "alpha_chunk": 1.0,
      "temperature_local": 2.5,
      "temperature_chunk": 2.5,
      "log_eps": 1e-12,
      "minmax_eps": 1e-06,
      "chunk_dropout": {
        "enabled": false,
        "probability": 0.2,
        "seed": 42
      },
      "alpha_schedule": {
        "enabled": false,
        "local": {
          "enabled": false,
          "start_step": 1,
          "end_step": 200,
          "end_alpha": 0.0
        },
        "chunk": {
          "enabled": false,
          "start_step": 1,
          "end_step": 200,
          "end_alpha": 0.0
        }
      }
    }
  }
}
