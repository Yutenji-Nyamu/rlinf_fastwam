+    def _log_optimizer_state(self, marker):
+        if os.environ.get("RLINF_CKPT_DIAG") != "1":
+            return
+        optimizers = (
+            (self.optimizers,)
+            if isinstance(self.optimizers, Optimizer)
+            else tuple(self.optimizers)
+        )
+        rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else -1
+        for index, optimizer in enumerate(optimizers):
+            params = [param for group in optimizer.param_groups for param in group["params"]]
+            missing = [param for param in params if param not in optimizer.state]
+            empty = [param for param in params if not optimizer.state.get(param)]
+            steps = []
+            for param in params:
+                step = optimizer.state.get(param, {}).get("step")
+                if step is not None:
+                    steps.append(float(step.item() if isinstance(step, torch.Tensor) else step))
+            print(
+                "RLINF_CKPT_DIAG "
+                f"marker={marker} rank={rank} optimizer={index} "
+                f"params={len(params)} state_entries={len(optimizer.state)} "
+                f"missing={len(missing)} empty={len(empty)} "
+                f"step_zero={sum(step == 0 for step in steps)} "
+                f"step_gt0={sum(step > 0 for step in steps)} "
+                f"step_min={min(steps) if steps else 'none'} "
+                f"step_max={max(steps) if steps else 'none'}",
+                flush=True,
+            )
+
