index 00000000..e8db951a
--- /dev/null
+++ b/examples/embodiment/config/robotwin_adjust_bottle_rlt_stage2_ac_mlp.yaml
@@ -0,0 +1,310 @@
+defaults:
+  - env/robotwin_adjust_bottle@env.train
+  - env/robotwin_adjust_bottle@env.eval
+  - hybrid_engines/fsdp@actor.fsdp_config
+  - weight_syncer/patch_syncer@weight_syncer
+  - override hydra/job_logging: stdout
+  - _self_
+
+hydra:
+  run:
+    dir: .
+  output_subdir: null
+
+cluster:
+  num_nodes: 1
+  # Reuse the verified RoboTwin 2xA800/4-env topology in an isolated worktree.
+  component_placement:
+    actor, env, rollout: 0-1
+
+runner:
+  task_type: embodied
+  logger:
+    log_path: ${oc.env:RLT_LOG_ROOT,/root/autodl-tmp/RLinf_rlt_pi0_robotwin_logs}
+    project_name: rlinf-rlt
+    experiment_name: "robotwin_adjust_bottle_rlt_stage2_ac_mlp"
+    logger_backends: ["tensorboard"]
+
+  max_epochs: 1000
+  # The formal collection-cycle budget is selected after the approved smoke.
+  max_steps: -1
+  only_eval: False
+  weight_sync_interval: 1
+  val_check_interval: 10
+  save_interval: 10
+  # This is a full Stage2 checkpoint directory, never a Stage1 actor path.
+  resume_dir: null
+  ckpt_path: null
+
+algorithm:
+  update_epoch: 5
+  group_size: 1
+
+  adv_type: embodied_sac
+  loss_type: rlt_ac
+  loss_agg_func: "token-mean"
+
+  agg_q: min
+  actor_agg_q: q1
+  enable_drq: False
+  q_head_type: ${actor.model.q_head_type}
+  bootstrap_type: standard
+  gamma: 0.99
+  tau: 0.005
+
+  # Full-task RoboTwin has no critical-phase gate or expert takeover. Before
+  # readiness, the frozen Stage1 reference acts; afterward, the RLT actor acts.
+  rlt_route:
+    type: full_task
+
+  # One compact replay row per environment transition. Pure time-limit
+  # truncation bootstraps from its real final observation.
+  rlt_transition_replay:
+    enable: True
+    compact: True
+    bootstrap_on_truncation: True
+
+  # warmup_min_size is per actor rank: 500/rank is about 1000 global rows.
+  # update_epoch=5 and train_every_transitions=1 implement global UTD=5.
+  rlt_schedule:
+    enable: True
+    max_updates_per_train_step: 400
+    warmup_min_size: 500
+    warmup_post_collect_updates: 5000
+    train_every_episodes: 0
+    train_every_transitions: 1
+
+  # RLT actor objective: -q_weight * Q + bc_weight * BC.
+  q_weight: 1.0
+  bc_weight: 1.0
+  reference_dropout_prob: 0.5
+  actor_weight_schedule:
+    enable: True
+    warmup_updates: 5000
+    ramp_updates: 10000
+    warmup_bc_weight: 7.0
+    warmup_q_weight: 0.05
+    online_bc_weight: 2.5
+    online_q_weight: 0.45
+
+  entropy_tuning:
+    alpha_type: fixed_alpha
+    initial_alpha: 0.0
+    optim:
+      lr: 3.0e-4
+      lr_scheduler: torch_constant
+      clip_grad: 10.0
+
+  replay_buffer:
+    enable_cache: True
+    cache_size: 15000
+    sample_window_size: 15000
+    # Readiness is owned by rlt_schedule; this only guards the local loader.
+    min_buffer_size: 1
+    auto_save: False
+
+  target_update_freq: 1
+  target_update_type: all
+  critic_actor_ratio: 2
+  critic_subsample_size: 0
+  backup_entropy: False
+
+  # Fresh runs also save this state. Actual execution must resolve every hash
+  # and manifest field; defaults deliberately fail closed at save/resume time
+  # while remaining Hydra-composeable.
+  rlt_resume:
+    enable: True
+    schema_version: 1
+    contract:
+      stage1_manifest_path: ${oc.env:RLT_STAGE1_MANIFEST_PATH,UNRESOLVED_RLT_STAGE1_MANIFEST_PATH}
+      stage1_manifest_id: ${oc.env:RLT_STAGE1_MANIFEST_ID,UNRESOLVED_RLT_STAGE1_MANIFEST_ID}
+      stage1_manifest_sha256: ${oc.env:RLT_STAGE1_MANIFEST_SHA256,UNRESOLVED_RLT_STAGE1_MANIFEST_SHA256}
+      norm_stats_sha256: ${oc.env:RLT_NORM_STATS_SHA256,UNRESOLVED_RLT_NORM_STATS_SHA256}
+      canonical_adapter_version: "robotwin_aloha_canonical_v1"
+
+env:
+  group_name: "EnvGroup"
+  enable_offload: True
+
+  train:
+    enable_offload: True
+    rollout_epoch: 1
+    total_num_envs: 4
+    auto_reset: False
+    ignore_terminations: False
+    use_rel_reward: False
+    reward_coef: 1.0
+    max_episode_steps: 200
+    max_steps_per_rollout_epoch: 200
+    group_size: ${algorithm.group_size}
+    assets_path: ${oc.env:ROBOTWIN_ASSETS_PATH,/root/autodl-tmp/RoboTwin_RLinf}
+    seeds_path: ${oc.env:REPO_PATH,/root/autodl-tmp/RLinf_rlt_pi0_robotwin}/rlinf/envs/robotwin/seeds/train_seeds.json
+    center_crop: False
+    video_cfg:
+      save_video: False
+    task_config:
+      embodiment: [aloha-agilex]
+      camera:
+        collect_wrist_camera: true
+      domain_randomization:
+        random_background: false
+        cluttered_table: false
+        clean_background_rate: 1
+        random_head_camera_dis: 0
+        random_table_height: 0
+        random_light: false
+        crazy_random_light_rate: 0
+
+  eval:
+    rollout_epoch: 1
+    total_num_envs: 4
+    auto_reset: True
+    ignore_terminations: True
+    use_rel_reward: False
+    reward_coef: 1.0
+    max_episode_steps: 200
+    max_steps_per_rollout_epoch: 200
+    group_size: 1
+    use_fixed_reset_state_ids: True
+    is_eval: True
+    assets_path: ${oc.env:ROBOTWIN_ASSETS_PATH,/root/autodl-tmp/RoboTwin_RLinf}
+    seeds_path: ${oc.env:REPO_PATH,/root/autodl-tmp/RLinf_rlt_pi0_robotwin}/rlinf/envs/robotwin/seeds/eval_seeds.json
+    center_crop: False
+    video_cfg:
+      save_video: False
+      video_base_dir: ${runner.logger.log_path}/video/eval
+    task_config:
+      embodiment: [aloha-agilex]
+      camera:
+        collect_wrist_camera: true
+      domain_randomization:
+        random_background: false
+        cluttered_table: false
+        clean_background_rate: 1
+        random_head_camera_dis: 0
+        random_table_height: 0
+        random_light: false
+        crazy_random_light_rate: 0
+
+rollout:
+  group_name: "RolloutGroup"
+  backend: "huggingface"
+  enable_offload: False
+  pipeline_stage_num: 1
+  collect_transitions: True
+  collect_prev_infos: False
+
+  # Synced Stage2 MLP policy. Stage1 weights belong only to rlt_feature_model.
+  model:
+    model_type: ${actor.model.model_type}
+    model_path: null
+    precision: ${actor.model.precision}
+    action_dim: ${actor.model.action_dim}
+    num_action_chunks: ${actor.model.num_action_chunks}
+    ref_num_action_chunks: ${actor.model.ref_num_action_chunks}
+    z_dim: ${actor.model.z_dim}
+    proprio_dim: ${actor.model.proprio_dim}
+    add_q_head: ${actor.model.add_q_head}
+    q_head_type: ${actor.model.q_head_type}
+    fixed_std: ${actor.model.fixed_std}
+    is_lora: False
+    lora_rank: 32
+
+  # Frozen Stage1 pi0 + RLT token transformer.
+  rlt_feature_model:
+    model_type: "openpi"
+    model_path: ${oc.env:RLT_STAGE1_MODEL_PATH,UNRESOLVED_RLT_STAGE1_MODEL_PATH}
+    precision: null
+    num_action_chunks: ${actor.model.ref_num_action_chunks}
+    action_dim: ${actor.model.action_dim}
+    add_value_head: False
+    is_lora: False
+    lora_rank: 32
+    openpi_data:
+      repo_id: "physical-intelligence/robotwin"
+      default_prompt: "adjust the bottle"
+      norm_stats_path: ${oc.env:ROBOTWIN_PI0_NORM_STATS_PATH,/root/autodl-tmp/models/rlinf/RLinf-Pi0-RoboTwin-SFT-adjust_bottle/physical-intelligence/robotwin/norm_stats.json}
+    openpi:
+      config_name: "pi0_aloha_robotwin"
+      num_images_in_input: 3
+      action_horizon: 50
+      action_chunk: ${actor.model.ref_num_action_chunks}
+      action_env_dim: ${actor.model.action_dim}
+      num_steps: 4
+      state_indices: []
+      train_expert_only: False
+      add_value_head: False
+      detach_critic_input: True
+      noise_method: "flow_ode"
+
+      use_rlt: True
+      rlt_train_vla: False
+      rlt_alpha: 0.0
+      rlt_input_dim: 2048
+      rlt_embed_dim: 2048
+      rlt_num_rl_tokens: 1
+      rlt_prefix_seq_len: 768
+      rlt_num_layers: 2
+      rlt_num_heads: 8
+      rlt_mlp_ratio: 4.0
+      rlt_encoder_type: "append_self_attention"
+      rlt_image_only: True
+      rlt_use_mask: True
+      rlt_action_adapter: "robotwin_aloha_canonical_v1"
+
+  enable_torch_compile: False
+  enable_cuda_graph: False
+
+actor:
+  group_name: "ActorGroup"
+  training_backend: "fsdp"
+  micro_batch_size: 128
+  global_batch_size: 512
+  seed: 1234
+  enable_offload: False
+
+  model:
+    model_type: "rlt_mlp_policy"
+    # Keep the small Stage2 head in fp32 for Q-learning stability.
+    precision: fp32
+    z_dim: 2048
+    proprio_dim: 14
+    action_dim: 14
+    num_action_chunks: 10
+    ref_num_action_chunks: 10
+    add_value_head: False
+    add_q_head: True
+    q_head_type: "default"
+    fixed_std: 0.002
+    is_lora: False
+    lora_rank: 32
+
+  optim:
+    clip_grad: 10.0
+    lr: 1.0e-4
+    lr_scheduler: torch_constant
+
+  critic_optim:
+    clip_grad: 10.0
+    lr: 1.0e-4
+    lr_scheduler: torch_constant
+
+  fsdp_config:
+    strategy: "fsdp"
+    sharding_strategy: "no_shard"
+    mixed_precision:
+      param_dtype: ${actor.model.precision}
+      reduce_dtype: ${actor.model.precision}
+      buffer_dtype: ${actor.model.precision}
+
+reward:
+  use_reward_model: False
+
+critic:
+  use_critic_model: False
+
+weight_syncer:
+  patch:
+    snapshot_device: cpu
+    init_sync:
+      enabled: true
