@@ -0,0 +1,119 @@
+defaults:
+  - model/pi0@actor.model
+  - hybrid_engines/fsdp@actor.fsdp_config
+  - override hydra/job_logging: stdout
+  - _self_
+
+hydra:
+  run:
+    dir: .
+  output_subdir: null
+  searchpath:
+    - file://${oc.env:EMBODIED_PATH}/config/
+
+cluster:
+  num_nodes: 1
+  # Match the verified RoboTwin pi0 two-GPU placement.
+  component_placement:
+    actor,env,rollout: 0-1
+
+runner:
+  task_type: sft
+  logger:
+    log_path: ${oc.env:RLT_LOG_ROOT,/root/autodl-tmp/RLinf_rlt_pi0_robotwin_logs}
+    project_name: rlinf-rlt
+    experiment_name: "robotwin_adjust_bottle_rlt_stage1_sft_openpi"
+    logger_backends: ["tensorboard"]
+
+  max_epochs: -1
+  # One fixed low-budget endpoint; do not select a Stage1 checkpoint by Stage2 RL.
+  max_steps: 2000
+  val_check_interval: -1
+  save_interval: 2000
+
+data:
+  # The converter contract is checked on one episode, while Stage1 consumes all
+  # valid clean-50 episodes without duplication or a held-out split.
+  train_data_paths:
+    - dataset_path: ${oc.env:ROBOTWIN_RLT_CLEAN50_PATH,/root/autodl-tmp/datasets/robotwin_adjust_bottle_clean50_lerobot}
+      weight: 1.0
+
+actor:
+  group_name: "ActorGroup"
+  training_backend: "fsdp"
+  # Inherit the verified RoboTwin pi0 SFT batch shape.
+  micro_batch_size: 16
+  global_batch_size: 32
+  seed: 0
+
+  model:
+    precision: null
+    model_path: ${oc.env:ROBOTWIN_PI0_BASE_PATH,/root/autodl-tmp/models/rlinf/RLinf-Pi0-RoboTwin-SFT-adjust_bottle}
+    num_action_chunks: 10
+    action_dim: 14
+    add_value_head: False
+    openpi_data:
+      repo_id: "physical-intelligence/robotwin"
+      default_prompt: "adjust the bottle"
+      # Stage1 and Stage2 must resolve to this exact file.
+      norm_stats_path: ${oc.env:ROBOTWIN_PI0_NORM_STATS_PATH,/root/autodl-tmp/models/rlinf/RLinf-Pi0-RoboTwin-SFT-adjust_bottle/physical-intelligence/robotwin/norm_stats.json}
+    openpi:
+      config_name: "pi0_aloha_robotwin"
+      num_images_in_input: 3
+      action_horizon: 50
+      action_chunk: ${actor.model.num_action_chunks}
+      action_env_dim: ${actor.model.action_dim}
+      num_steps: 4
+      train_expert_only: False
+      detach_critic_input: True
+      noise_method: "flow_ode"
+
+      use_rlt: True
+      # Token-only Stage1: the pi0 backbone is genuinely frozen and excluded
+      # from optimization rather than relying on a zero-weight VLA loss.
+      rlt_train_vla: False
+      rlt_alpha: 0.0
+      rlt_input_dim: 2048
+      rlt_embed_dim: 2048
+      rlt_num_rl_tokens: 1
+      # Three image streams x 256 tokens. The real-checkpoint prefix probe must
+      # confirm this contract before Stage1 is run.
+      rlt_prefix_seq_len: 768
+      rlt_num_layers: 2
+      rlt_num_heads: 8
+      rlt_mlp_ratio: 4.0
+      rlt_encoder_type: "append_self_attention"
+      rlt_image_only: True
+      rlt_use_mask: True
+      rlt_action_adapter: "robotwin_aloha_canonical_v1"
+
+  optim:
+    lr: 2.5e-5
+    adam_beta1: 0.9
+    adam_beta2: 0.95
+    adam_eps: 1.0e-08
+    weight_decay: 1.0e-10
+    clip_grad: 1.0
+    total_training_steps: 2000
+    lr_warmup_steps: 100
+    lr_scheduler: "cosine"
+    num_cycles: 0.5
+    min_lr: 2.5e-6
+
+  fsdp_config:
+    strategy: "fsdp"
+    # Stage1 only trains the small RLT module. Replication keeps the port close
+    # to the official ManiSkill Stage1 route and avoids mixed freeze/shard risk.
+    sharding_strategy: "no_shard"
+    use_orig_params: True
+    gradient_checkpointing: False
+    mixed_precision:
+      param_dtype: ${actor.model.precision}
+      reduce_dtype: ${actor.model.precision}
+      buffer_dtype: ${actor.model.precision}
+
+reward:
+  use_reward_model: False
+
+critic:
+  use_critic_model: False
