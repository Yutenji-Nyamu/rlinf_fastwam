+def test_canonical_decode_overwrites_only_slice_and_matches_transform():
+    openpi_action_model = _openpi_action_model_class()
+    model = _TinyOpenPi(
+        SimpleNamespace(
+            rlt_action_adapter="robotwin_aloha_canonical_v1",
