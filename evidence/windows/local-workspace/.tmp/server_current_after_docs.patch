+    changed.rlt_resume_cfg.contract = source.rlt_resume_cfg.contract
+
+    with pytest.raises(ValueError, match="contract fingerprint mismatch"):
+        changed._preflight_rlt_trainer_state(str(checkpoint_dir))
+
