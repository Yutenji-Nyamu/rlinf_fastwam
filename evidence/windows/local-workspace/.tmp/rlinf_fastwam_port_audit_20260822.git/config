[core]
	repositoryformatversion = 1
	filemode = false
	bare = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/Yutenji-Nyamu/rlinf_fastwam.git
	tagOpt = --no-tags
	promisor = true
	partialclonefilter = blob:none
[remote "upstream"]
	url = https://github.com/RLinf/RLinf.git
	fetch = +refs/heads/*:refs/remotes/upstream/*
	promisor = true
	partialclonefilter = blob:none
[gc]
	auto = 0
