+  seed: 1234
+  enable_offload: False
+  enable_drq: True
+  compile_model: False
+
+  model:
+    model_path: "/data/chenyiteng/models/rlinf/RLinf-Pi0-RoboTwin-SFT-adjust_bottle@92684e50"
+    num_action_chunks: 20
+    action_dim: 14
+    add_value_head: False
