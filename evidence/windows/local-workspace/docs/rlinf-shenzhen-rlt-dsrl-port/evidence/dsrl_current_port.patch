+    optim:
+      lr: 3.0e-4
+      lr_scheduler: torch_constant
+      clip_grad: 10.0
+
+  replay_buffer:
+    type: dsrl_transition
+    schema_version: 1
+    capacity: 25000
+    warmup_size: 500
+    min_buffer_size: 1
+    enable_preload: False
+
+  target_update_freq: 1
+  target_update_type: all
+  filter_rewards: False
+  rewards_lower_bound: 0.1
+  rewards_upper_bound: 0.9
+
