+def test_ring_rejects_world_size_change(tmp_path):
+    replay = DSRLTransitionReplayBuffer(
+        capacity=6,
+        seed=3,
+        rank=0,
+        world_size=1,
+    )
+    replay.add_batch(_synthetic_batch(2))
