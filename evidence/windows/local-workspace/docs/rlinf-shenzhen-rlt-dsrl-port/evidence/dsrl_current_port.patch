+  - _self_
+
+hydra:
+  run:
+    dir: .
+  output_subdir: null
+
+cluster:
+  num_nodes: 1
+  # Topology-neutral: global batch/replay capacity are split by actor world size.
+  # Choose the visible 1/2/4 GPUs in the launch packet after resource discussion.
+  component_placement:
+    actor, env, rollout: all
+
+runner:
+  task_type: embodied
+  logger:
+    log_path: "/data/chenyiteng/results/rlinf-current-dsrl"
+    project_name: rlinf
+    experiment_name: "robotwin_adjust_bottle_dsrl_openpi"
+    logger_backends: ["tensorboard"]
+  max_epochs: 1000
+  max_steps: -1
+  only_eval: False
+  val_check_interval: -1
+  save_interval: 10
+  resume_dir: null
+  ckpt_path: null
+
+algorithm:
+  normalize_advantages: False
+  kl_penalty: kl
+  group_size: 1
+  reward_coef: 1.0
+  reward_type: chunk_level
+  logprob_type: chunk_level
+  entropy_type: token_level
+
+  # The compact DSRL path uses utd_ratio * globally-new macro transitions.
+  update_epoch: 1
+  utd_ratio: 20
+  adv_type: embodied_sac
+  loss_type: embodied_sac
+  loss_agg_func: "token-mean"
